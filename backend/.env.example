# Copia este archivo a backend/.env (no se versiona). npm start/dev lo cargan solos.

# Puerto del API (y del frontend compilado, si existe frontend/dist)
PORT=3001

# Producción: activa cookie Secure, HSTS y logs "combined"
# NODE_ENV=production

# Si en producción se sirve por HTTP (red interna sin certificado), la cookie
# Secure no viajaría y nadie podría iniciar sesión. Con HTTPS, dejar sin definir.
# COOKIE_SECURE=false

# Orígenes que pueden llamar al API desde un navegador (separados por coma).
# Solo hace falta si el frontend está en OTRO origen (p. ej. el dev server :5173).
CORS_ORIGIN=http://localhost:5173

# Detrás de un proxy inverso (nginx, Caddy, Cloudflare…): nº de saltos de proxy.
# Necesario para que el bloqueo por intentos use la IP real del cliente.
# TRUST_PROXY=1

# Ruta de la base SQLite (por defecto backend/data/viaticos.db)
# DB_PATH=./data/viaticos.db
